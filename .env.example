# Copy to .env and fill in. .env is gitignored - never commit real secrets.

# Required for the agent (intent classifier + chat). Deterministic `make test`
# and `make agent-eval` do NOT need a key.
OPENAI_API_KEY=sk-replace-me
# Optional: override the model (default gpt-4o-mini).
# LLM_MODEL=gpt-4o-mini
# Optional: point at an OpenAI-compatible endpoint.
# OPENAI_BASE_URL=

# Agent -> platform API (defaults are fine for `make up`).
# EMP_BASE_URL=http://backend:8000
# EMP_TOKEN=tok_1

# Postgres (defaults are fine for local dev).
# POSTGRES_USER=emp
# POSTGRES_PASSWORD=emp
# POSTGRES_DB=emp
